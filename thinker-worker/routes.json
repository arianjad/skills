{
  "schema": 1,
  "$override": {
    "path": "TW_ROUTES_OVERRIDE, else ~/.thinker-worker/routes.json (machine-local, survives reinstalls)",
    "may_set": ["router.priors", "router.model_priors", "router.defaults"]
  },
  "harnesses": {
    "claude": {
      "roles": {
        "worker": {
          "models": ["opus", "claude-opus-5", "claude-opus-5-5", "gpt-6-sol", "sonnet", "claude-sonnet-5-5", "gpt-6.1-sol", "gpt-6.1-terra", "haiku", "claude-haiku-5-5"],
          "tiers": ["low", "medium", "high", "xhigh", "max"],
          "tools": null
        },
        "leaf": {
          "models": ["sonnet", "claude-sonnet-5", "claude-sonnet-5-5", "gpt-6-luna", "haiku", "claude-haiku-5-5", "gpt-6.1-terra"],
          "tiers": ["low", "medium", "high", "xhigh", "max"],
          "tools": null
        },
        "independent-review": {
          "models": ["fable", "claude-fable-5", "claude-fable-5-1", "gpt-6-astra", "gpt-6-sol", "gpt-6.1-sol", "claude-opus-5-5", "gpt-6.1-terra", "haiku", "claude-haiku-5-5", "claude-fable-5-2"],
          "tiers": ["low", "medium", "high", "xhigh", "max"],
          "tools": null
        },
        "ideation": {
          "models": ["fable", "claude-fable-5", "claude-fable-5-1", "opus", "claude-opus-5", "claude-opus-5-5", "gpt-6-astra", "claude-fable-5-2"],
          "tiers": ["medium", "high", "xhigh"],
          "tools": null
        }
      }
    },
    "codex": {
      "roles": {
        "worker": {
          "models": ["gpt-6-sol", "gpt-5.6-sol", "gpt-5.6-terra", "gpt-6.1-sol", "gpt-6.1-terra"],
          "tiers": ["low", "medium", "high", "xhigh", "max"]
        },
        "leaf": {
          "models": ["gpt-6-luna", "gpt-6.1-terra"],
          "tiers": ["low", "medium", "high", "xhigh", "max"]
        },
        "independent-review": {
          "models": ["gpt-6-astra", "gpt-6.1-sol", "gpt-6.1-terra"],
          "tiers": ["low", "medium", "high", "xhigh", "max"]
        },
        "ideation": {
          "models": ["gpt-6-astra"],
          "tiers": ["medium", "high", "xhigh"]
        }
      }
    }
  },
  "router": {
    "defaults": {
      "independent-review": "gpt-6-astra",
      "ideation": "fable"
    },
    "priors": {
      "*": "medium",
      "T1-mechanical": "low",
      "T2-simple-transform": "low",
      "T3-moderate-reasoning": "medium",
      "T4-hard-reasoning": "high",
      "R-research": "medium",
      "C-coding": "high"
    },
    "model_priors": {
      "haiku": {
        "*": "medium",
        "T1-mechanical": "low",
        "T2-simple-transform": "low",
        "T3-moderate-reasoning": "high",
        "T4-hard-reasoning": "high",
        "R-research": "medium",
        "C-coding": "high"
      },
      "claude-haiku-5-5": {
        "*": "medium",
        "T1-mechanical": "low",
        "T2-simple-transform": "low",
        "T3-moderate-reasoning": "high",
        "T4-hard-reasoning": "high",
        "R-research": "medium",
        "C-coding": "high"
      },
      "sonnet": {
        "*": "low",
        "T1-mechanical": "low",
        "T2-simple-transform": "low",
        "T3-moderate-reasoning": "medium",
        "T4-hard-reasoning": "high",
        "R-research": "medium",
        "C-coding": "medium"
      },
      "claude-sonnet-5-5": {
        "*": "low",
        "T1-mechanical": "low",
        "T2-simple-transform": "low",
        "T3-moderate-reasoning": "medium",
        "T4-hard-reasoning": "high",
        "R-research": "medium",
        "C-coding": "medium"
      }
    }
  }
}
