{
  "schema": 1,
  "$override": {
    "path": "TW_ROUTES_OVERRIDE, else ~/.thinker-worker/routes.json (machine-local, survives reinstalls)",
    "may_set": ["router.priors", "router.model_priors", "router.classes", "router.risk_floor", "router.defaults", "router.backends", "router.combine", "router.options", "router.<jev backend block>"]
  },
  "harnesses": {
    "claude": {
      "roles": {
        "worker": {
          "models": ["opus", "claude-opus-5", "claude-opus-5-5", "gpt-6-sol", "sonnet", "claude-sonnet-5-5", "gpt-6.1-sol"],
          "tiers": ["low", "medium", "high", "xhigh"],
          "tools": null,
          "model_tiers": {
            "sonnet": ["high", "xhigh"],
            "claude-sonnet-5-5": ["high", "xhigh"]
          }
        },
        "leaf": {
          "models": ["sonnet", "claude-sonnet-5", "claude-sonnet-5-5", "gpt-6-luna"],
          "tiers": ["low", "medium", "high"],
          "tools": null
        },
        "independent-review": {
          "models": ["fable", "claude-fable-5", "claude-fable-5-1", "gpt-6-astra", "gpt-6-sol"],
          "tiers": ["medium", "high", "xhigh"],
          "tools": null
        },
        "ideation": {
          "models": ["fable", "claude-fable-5", "claude-fable-5-1", "opus", "claude-opus-5", "claude-opus-5-5", "gpt-6-astra"],
          "tiers": ["medium", "high", "xhigh"],
          "tools": null
        }
      }
    },
    "codex": {
      "roles": {
        "worker": {
          "models": ["gpt-6-sol", "gpt-5.6-sol", "gpt-5.6-terra", "gpt-6.1-sol"],
          "tiers": ["low", "medium", "high", "xhigh"]
        },
        "leaf": {
          "models": ["gpt-6-luna"],
          "tiers": ["low", "medium", "high"]
        },
        "independent-review": {
          "models": ["gpt-6-astra"],
          "tiers": ["medium", "high", "xhigh"]
        },
        "ideation": {
          "models": ["gpt-6-astra"],
          "tiers": ["medium", "high", "xhigh"]
        }
      }
    }
  },
  "router": {
    "backends": [],
    "kev": {
      "kind": "jev",
      "url": "http://127.0.0.1:8766/v1/systemone",
      "body_chars": 1500
    },
    "laya": {
      "kind": "jev",
      "url": "http://127.0.0.1:8767/v1/systemone",
      "body_chars": 1100
    },
    "combine": {
      "margin": 0.2
    },
    "options": {
      "low": "Direct execution of a specified method; limited alternative search.",
      "medium": "Work through dependent steps and perform ordinary verification, when the brief already fixes what to do.",
      "high": "Compare plausible approaches, investigate failures, and check assumptions, or decide what the task needs when that is part of the work.",
      "xhigh": "Sustain extensive alternative search and adversarial checking."
    },
    "budget_s": 2.0,
    "defaults": {
      "independent-review": "gpt-6-astra",
      "ideation": "fable"
    },
    "risk_floor": {
      "physics": "medium",
      "destructive": "medium",
      "external": "medium"
    },
    "priors": {
      "*": "medium",
      "T1-mechanical": "low",
      "T2-simple-transform": "low",
      "T3-moderate-reasoning": "medium",
      "T4-hard-reasoning": "high",
      "R-research": "medium",
      "C-coding": "high"
    },
    "table": {
      "path": "~/Code/effortmining/bench/state/calibration.json"
    },
    "classes": {
      "*": {
        "mode": "advisory",
        "explore": {
          "c": 0.5,
          "power": 0.25,
          "floor": 0.05
        }
      }
    }
  }
}
